<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release only. Replaces myBrowser.entitlements, so the JIT exception stays.
	     Developer ID uses the production CloudKit environment. No ubiquity
	     container: the library syncs as CloudKit records, not iCloud Documents. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Do not add com.apple.developer.web-browser.public-key-credential here.
	     Switching Release to this file would SIGKILL launch (exit 137) unless the
	     Developer ID profile also grants that key. When both iCloud and passkeys
	     are approved, add the key to this file and use a profile that includes both.
	     See docs/architecture.md, Passkeys. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.ch.marvinvr.mybrowser</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
