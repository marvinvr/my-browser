<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks JIT. WKWebView's JavaScript compiler needs this on the host app.
	     Not sandboxed, so no provisioning profile is required for this entitlement. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Do not add com.apple.developer.web-browser.public-key-credential here.
	     scripts/release.sh signs this file. On macOS 27 an ad-hoc hardened-runtime
	     binary with that key and no provisioning profile is SIGKILL (exit 137)
	     before main. The switch-on file is myBrowser-passkeys.entitlements.
	     See docs/architecture.md, Passkeys. -->
</dict>
</plist>
