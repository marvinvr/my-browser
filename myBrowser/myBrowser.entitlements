<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks JIT. WKWebView's JavaScript compiler needs this on the host app.
	     Not sandboxed, so no provisioning profile is required for this entitlement. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
